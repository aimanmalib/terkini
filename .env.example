# Copy to .env and fill in. .env is ignored by git. Never commit real values.

# Tavily API key for live mode. Leave empty to use replay mode with recorded fixtures.
TAVILY_API_KEY=

# Bifrost gateway that Terkini calls for every model request.
BIFROST_URL=
# Bifrost virtual key used by Terkini.
BIFROST_VIRTUAL_KEY=

# Upstream OpenAI-compatible provider that Bifrost forwards to (used by the demo compose file).
PROVIDER_BASE_URL=
PROVIDER_API_KEY=

# Bifrost admin setup token, shared by the gateway container and the bootstrap script. Pick any long random value.
BIFROST_SETUP_TOKEN=
# Host port for the gateway (bound to 127.0.0.1 only).
BIFROST_PORT=18471
